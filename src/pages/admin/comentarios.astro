---
// src/pages/admin/comentarios.astro
import Layout from '../../layouts/Layout.astro';
import { listPendingComments } from '../../lib/db';
export const prerender = false;

const pendientes = listPendingComments();
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
---
<Layout title="Moderación de comentarios" url="/admin/comentarios/">
  <script>
    // Si no hay secret en localStorage, pedirlo una vez.
    let secret = '';
    try { secret = localStorage.getItem('admin_secret') || ''; } catch (e) { /* ignore */ }

    function setSecret() {
      const v = prompt('Introduce el secret de moderación (ADMIN_SECRET):');
      if (v) { secret = v.trim(); try { localStorage.setItem('admin_secret', secret); } catch (e) {} }
    }
    if (!secret) setSecret();

    async function api(path, opts = {}) {
      const r = await fetch(path, {
        ...opts,
        headers: { ...(opts.headers || {}), 'x-admin-secret': secret, 'content-type': 'application/json' },
      });
      if (r.status === 401) { setSecret(); return api(path, opts); }
      return r;
    }

    async function moderar(id, accion) {
      const r = await api('/api/admin/comments', {
        method: 'POST',
        body: JSON.stringify({ id, accion }),
      });
      if (r.ok) location.reload();
    }
    window.moderar = moderar;
  </script>

  <div class="flex items-center justify-between">
    <h1 class="font-serif text-3xl font-bold text-slate-900 dark:text-white">Moderación de comentarios</h1>
    <span class="rounded-full bg-accent-100 px-3 py-1 text-sm font-semibold text-accent-800 dark:bg-accent-900/40 dark:text-accent-200">
      {pendientes.length} pendientes
    </span>
  </div>

  {pendientes.length === 0 ? (
    <p class="mt-8 text-slate-500">No hay comentarios pendientes de moderar.</p>
  ) : (
    <ul class="mt-6 space-y-4">
      {pendientes.map((c) => (
        <li class="rounded-xl border border-slate-200 p-5 dark:border-slate-800">
          <div class="mb-2 flex items-baseline justify-between gap-3">
            <span class="font-semibold text-slate-900 dark:text-white">{c.autor}</span>
            <span class="text-xs text-slate-400">{fmt.format(new Date(c.fecha))}</span>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-300">{c.texto}</p>
          <div class="mt-3 flex items-center gap-3">
            <span class="text-xs text-slate-400">post: <code>{c.post_slug}</code></span>
            <button onclick={`moderar('${c.id}','aprobado')`}
              class="rounded-lg bg-green-600 px-4 py-1.5 text-sm font-semibold text-white hover:bg-green-700">Aprobar</button>
            <button onclick={`moderar('${c.id}','rechazado')`}
              class="rounded-lg bg-red-600 px-4 py-1.5 text-sm font-semibold text-white hover:bg-red-700">Rechazar</button>
          </div>
        </li>
      ))}
    </ul>
  )}
</Layout>
