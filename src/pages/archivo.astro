---
// src/pages/archivo.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getIndiePosts } from '../lib/indie';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const porAnio = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.pubDate.getFullYear();
  if (!porAnio.has(y)) porAnio.set(y, [] as unknown as typeof posts);
  (porAnio.get(y) as typeof posts).push(p);
}
const anios = [...porAnio.keys()].sort((a, b) => b - a);
---
<Layout
  title="Archivo"
  description="Todas las publicaciones del blog, ordenadas por fecha."
  url="/archivo/"
>
  <h1 class="font-serif text-4xl font-bold text-slate-900 dark:text-white">Archivo</h1>
  <p class="mt-3 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
    Todas las publicaciones, de la más reciente a la más antigua. Para buscar por tema, usa
    <a href="/buscar" class="font-medium text-accent-600 dark:text-accent-400">el buscador</a> o
    <a href="/tags" class="font-medium text-accent-600 dark:text-accent-400">las series</a>.
  </p>

  {anios.map((y) => (
    <section class="mt-10">
      <h2 class="border-b border-slate-200 pb-2 font-serif text-2xl font-bold text-slate-900 dark:border-slate-800 dark:text-white">{y}</h2>
      <ul class="mt-4 divide-y divide-slate-200 dark:divide-slate-800">
        {(porAnio.get(y) as typeof posts).map((p) => (
          <li class="py-4">
            <div class="flex flex-wrap items-baseline gap-3">
              <time class="text-sm text-slate-500 dark:text-slate-400" datetime={p.data.pubDate.toISOString()}>{fmt.format(p.data.pubDate)}</time>
              {p.data.serie && (
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">{p.data.serie}</span>
              )}
            </div>
            <a href={`/posts/${p.slug}/`} class="mt-1 block font-serif text-xl font-bold text-slate-900 transition hover:text-accent-700 dark:text-white dark:hover:text-accent-400">
              {p.data.title}
            </a>
            {p.data.description && (
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{p.data.description}</p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
