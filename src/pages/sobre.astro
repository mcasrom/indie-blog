---
import Layout from '../layouts/Layout.astro';
const title = 'Sobre el proyecto';
const description = 'indie es un blog sobre herramientas que resuelven problemas sin ruido: software pequeño, hecho con intención, que puedes entender, probar y modificar.';
const url = 'https://indie.pruebapublica.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Sobre el proyecto',
  url: `${url}/sobre/`,
  inLanguage: 'es-ES',
  isPartOf: { '@type': 'WebSite', name: 'indie', url },
  about: {
    '@type': 'Blog',
    name: 'indie',
    url,
    description,
    author: { '@type': 'Person', name: 'M. Castillo' },
  },
};
---
<Layout title={title} description={description} url="/sobre/">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <main class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-12 border-b border-slate-200 pb-8 dark:border-slate-800">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
        Sobre el proyecto
      </p>
      <h1 class="mt-3 font-serif text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        Sobre indie
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
        <strong class="font-semibold text-slate-900 dark:text-white">indie</strong> es un blog sobre
        herramientas que resuelven problemas sin ruido: software pequeño, hecho con intención,
        que puedes entender, probar y modificar. Sin estrategias para robarte la atención,
        sin cuentas obligatorias.
      </p>
    </header>

    <div class="space-y-10">
      <section>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
          De qué se habla aquí
        </h2>
        <p class="mt-3 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
          Linux como punto de partida y, desde ahí, todo el mundo indie: escritorio, terminal y CLI,
          automatización, self-hosting y homelab, y ese software hecho a mano que merece la pena probar.
        </p>
      </section>

      <section>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
          Cómo se escribe
        </h2>
        <p class="mt-3 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
          Práctico, honesto y directo. Si algo no funciona, se dice. Si merece la pena, se explica
          con ejemplos reales y probados.
        </p>
      </section>

      <section>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
          Quién lo escribe
        </h2>
        <p class="mt-3 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
          Una persona, desde la práctica diaria con Linux. ¿Quieres proponer una herramienta o un tema?
          Escribe a
          <a href="mailto:indie@pruebapublica.com" class="font-medium text-accent-700 underline underline-offset-4 hover:text-accent-800 dark:text-accent-400 dark:hover:text-accent-300">
            indie@pruebapublica.com
          </a>.
        </p>
      </section>
    </div>

    <footer class="mt-14 rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/40">
      <p class="text-base leading-relaxed text-slate-600 dark:text-slate-400">
        Si es tu primera vez, empieza por
        <a href="/empieza-aqui/" class="font-medium text-accent-700 hover:underline dark:text-accent-400">aquí</a>.
        También puedes ver el
        <a href="/archivo/" class="font-medium text-accent-700 hover:underline dark:text-accent-400">archivo completo</a>,
        el <a href="/tags/" class="font-medium text-accent-700 hover:underline dark:text-accent-400">índice de etiquetas</a>, la <a href="/linea-editorial/" class="font-medium text-accent-700 hover:underline dark:text-accent-400">línea editorial</a>
        o suscribirte al <a href="/rss.xml" class="font-medium text-accent-700 hover:underline dark:text-accent-400">RSS</a>.
      </p>
    </footer>
  </main>
</Layout>
