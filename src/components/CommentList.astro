---
// src/components/CommentList.astro
interface Props { slug: string }
const { slug } = Astro.props;
const { listComments } = await import('../lib/db');
const comments = listComments(slug);
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
---
{comments.length > 0 && (
<div data-comment-list data-slug={slug} class="mt-6">
  <h4 class="mb-3 text-sm font-semibold text-slate-500 dark:text-slate-400">Comentarios ({comments.length})</h4>
  <ul class="space-y-4">
    {comments.map((c) => (
      <li class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
        <div class="mb-1 flex items-baseline justify-between">
          <span class="text-sm font-semibold text-slate-900 dark:text-white">{c.autor}</span>
          <time class="text-xs text-slate-400" datetime={c.fecha}>{fmt.format(new Date(c.fecha))}</time>
        </div>
        <p class="text-sm text-slate-700 dark:text-slate-300">{c.texto}</p>
      </li>
    ))}
  </ul>
</div>
)}
