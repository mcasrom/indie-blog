---
// src/components/CommentForm.astro
interface Props { slug: string }
const { slug } = Astro.props;
---
<div class="mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
  <h3 class="mb-4 font-serif text-lg font-bold text-slate-900 dark:text-white">Deja un comentario</h3>
  <form data-comment-form data-slug={slug} class="space-y-3">
    <input name="autor" type="text" maxlength="80" placeholder="Tu nombre"
      class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-accent-600 focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
      required />
    <textarea name="texto" rows="4" maxlength="2000" placeholder="Tu comentario (se publica tras moderación)"
      class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-accent-600 focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
      required></textarea>
    <button type="submit"
      class="rounded-lg bg-accent-600 px-5 py-2 text-sm font-semibold text-white transition hover:bg-accent-700">
      Enviar comentario
    </button>
    <p data-msg class="text-sm text-slate-500" role="status"></p>
  </form>
</div>

<script>
  const form = document.querySelector('[data-comment-form]') as HTMLFormElement | null;
  if (form) {
    const slug = form.dataset.slug || '';
    const msg = form.querySelector('[data-msg]') as HTMLElement;
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const autor = (form.querySelector('[name=autor]') as HTMLInputElement).value;
      const texto = (form.querySelector('[name=texto]') as HTMLTextAreaElement).value;
      msg.textContent = 'Enviando…';
      try {
        const r = await fetch(`/api/comment/${encodeURIComponent(slug)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ autor, texto }),
        });
        const data = await r.json();
        if (!r.ok) { msg.textContent = data.message || 'Error al enviar.'; return; }
        msg.textContent = 'Comentario enviado. Se publicará tras moderación.';
        form.reset();
      } catch { msg.textContent = 'Error de red. Inténtalo de nuevo.'; }
    });
  }
</script>
