---
// src/components/Header.astro
import ThemeToggle from './ThemeToggle.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const ultimo = posts[0];

const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/empieza-aqui/', label: 'Empieza aquí' },
  { href: '/buscar', label: 'Buscar' },
  { href: '/tags', label: 'Etiquetas' },
  { href: '/sobre', label: 'Sobre el proyecto' },
];
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="flex min-w-0 flex-col leading-none">
      <span class="font-serif text-3xl font-bold tracking-tight text-slate-900 dark:text-white">indie</span>
      <span class="mt-1 truncate text-xs text-slate-500 dark:text-slate-400">Linux, self-hosting y software hecho a mano</span>
    </a>
    <nav class="flex items-center gap-4 sm:gap-6">
      {nav.map((n) => (
        <a href={n.href} class="hidden text-sm text-slate-600 transition hover:text-accent-600 dark:text-slate-300 dark:hover:text-accent-400 sm:block">
          {n.label}
        </a>
      ))}
      <a
        href="/suscribirse"
        class="rounded-full bg-accent-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-700 dark:hover:bg-accent-500"
      >
        Suscribirse
      </a>
      <a
        href="/buscar"
        title="Buscar en el archivo"
        aria-label="Buscar"
        class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-slate-100 p-2 text-slate-600 transition hover:bg-slate-200 hover:text-accent-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-accent-400"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <a
        href="https://mastodon.social/@PruebaPublica"
        target="_blank"
        rel="noopener noreferrer"
        title="Síguenos en Mastodon"
        aria-label="Mastodon"
        class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-slate-100 p-2 text-slate-600 transition hover:bg-slate-200 hover:text-accent-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-accent-400"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M18.64 1.91H5.36c-1.43 0-2.59 1.16-2.59 2.59v13.18c0 1.19.87 2.2 2.04 2.39l.55.09a1.6 1.6 0 0 0 2.25-1.52v-1.7a1.6 1.6 0 0 1 1.32-1.58c2.27-.3 4.89-.3 7.16 0a1.6 1.6 0 0 1 1.32 1.58v1.7a1.6 1.6 0 0 0 2.25 1.52l.55-.09a2.42 2.42 0 0 0 2.04-2.39V4.5c0-1.43-1.16-2.59-2.59-2.59Zm-11.77 11.49c-1.16 0-2.03-.53-2.46-1.5-.37-.82.27-1.73 1.16-1.73.8 0 1.35.43 1.61 1.1.5 1.27 1.86 1.82 3.21 1.82 1.35 0 2.71-.55 3.21-1.82.26-.67.81-1.1 1.61-1.1.89 0 1.53.9 1.16 1.73-.43.97-1.3 1.5-2.46 1.5-.57 0-1.09-.1-1.5-.28.32.79.99 1.32 1.79 1.5l-.03 2.02c0 .58-.47 1.05-1.05 1.05-.6 0-1.05-.47-1.05-1.05v-2.06c-.55.02-1.13.03-1.73.03s-1.18-.01-1.73-.03v2.06c0 .58-.45 1.05-1.05 1.05a1.05 1.05 0 0 1-1.05-1.05v-2.02c.8-.18 1.47-.7 1.79-1.5-.4.18-.92.28-1.49.28Z"/></svg>
      </a>
      <a
        href="https://x.com/pruebapublicaX"
        target="_blank"
        rel="noopener noreferrer"
        title="Síguenos en X"
        aria-label="X"
        class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-slate-100 p-2 text-sm font-bold text-slate-600 transition hover:bg-slate-200 hover:text-accent-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-accent-400"
      >
        <span aria-hidden="true">X</span>
      </a>
      <a
        href="https://bsky.app/profile/pruebapublica.bsky.social"
        target="_blank"
        rel="noopener noreferrer"
        title="Síguenos en Bluesky"
        class="inline-flex items-center justify-center gap-1.5 rounded-full bg-accent-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-accent-700 dark:hover:bg-accent-500 sm:px-4"
      >
        <span class="text-accent-200">🦋</span>
        <span class="hidden sm:inline">Síguenos</span>
      </a>
      <ThemeToggle />
    </nav>
  </div>
  {ultimo && (
    <div class="border-t border-slate-100 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-800/40">
      <div class="mx-auto flex max-w-6xl items-center gap-2 overflow-hidden px-4 py-1.5 text-xs">
        <span class="shrink-0 font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">Último</span>
        <a href={`/posts/${ultimo.slug}/`} class="truncate text-slate-600 transition hover:text-accent-600 dark:text-slate-300 dark:hover:text-accent-400">
          {ultimo.data.title}
        </a>
        <a href={`/posts/${ultimo.slug}/`} class="shrink-0 font-semibold text-accent-600 hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300">
          Leer →
        </a>
      </div>
    </div>
  )}
</header>
